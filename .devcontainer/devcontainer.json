{
  "name": "PageManager v2 - Linux runtime",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [8020],
  "portsAttributes": {
    "8020": { "label": "PageManager v2", "onAutoForward": "silent" },
    "8021": { "onAutoForward": "ignore" },
    "55432": { "onAutoForward": "ignore" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "postStartCommand": "python3 v2/scripts/codespaces_start.py --start",
  "remoteUser": "vscode"
}
